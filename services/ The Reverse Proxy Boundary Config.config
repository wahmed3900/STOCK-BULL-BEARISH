3. The Reverse Proxy Boundary Config (`nginx.conf`)
Save this file in your root folder. It intercepts public HTTP requests and routes them cleanly into the Flask runtime container.

```nginx
events { 
    worker_connections 1024; 
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    upstream flask_cluster {
        server app:5000;
    }

    server {
        listen 80;
        server_name localhost;

        # Direct timeouts configuration 
        proxy_connect_timeout 10s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;

        location / {
            proxy_pass http://flask_cluster;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
            proxy_redirect off;
            
            # Disable buffering for system data event streaming loops
            proxy_buffering off;
            proxy_cache off;
        }
    }
}
