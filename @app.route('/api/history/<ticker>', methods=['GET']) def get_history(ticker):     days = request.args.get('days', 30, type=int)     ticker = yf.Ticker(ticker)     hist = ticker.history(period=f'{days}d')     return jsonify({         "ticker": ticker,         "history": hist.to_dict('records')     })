# Stream endpoint
@app.route('/stream/<ticker>', methods=['GET', 'HEAD'])
@limiter.limit("30 per minute")
def stream_data(ticker):
    """Stream real-time data for a ticker"""
    try:
        ticker_obj = yf.Ticker(ticker)
        info = ticker_obj.info
        
        # Get current price
        current_price = info.get('regularMarketPrice', info.get('currentPrice', 0))
        previous_close = info.get('regularMarketPreviousClose', info.get('previousClose', current_price))
        
        change = ((current_price - previous_close) / previous_close * 100) if previous_close else 0
        
        data = {
            'ticker': ticker.upper(),
            'price': current_price,
            'change': round(change, 2),
            'volume': info.get('regularMarketVolume', 0),
            'timestamp': datetime.utcnow().isoformat()
        }
        return jsonify(data), 200
    except Exception as e:
        logger.error(f"Stream error for {ticker}: {str(e)}")
        return jsonify({'error': 'Stream unavailable'}), 503

