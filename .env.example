# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional fallback if yfinance gets rate-limited. Free key at
# https://www.alphavantage.co/support/#api-key (25 requests/day on free tier)
ALPHA_VANTAGE_API_KEY=

# MongoDB connection string.
# Local: mongodb://localhost:27017
# Free Atlas cluster: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=stock_dashboard
