# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
ENV/
.env
.env.local
.env.*.local

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
app_log.txt

# Python build
*.egg
*.egg-info/
dist/
build/
*.whl

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# Project specific
*.save
*.zip
*.tar.gz
.env.save
requirements.txt.save
stock_analyzer.py.save
EOF
